// Database schema for the bike rental app.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BikeType {
  GRAVEL
  MTB
  CITY
}

enum BikeStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum RentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  rentals   Rental[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Station {
  id        String   @id @default(cuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  bikes     Bike[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bike {
  id           String     @id @default(cuid())
  model        String
  type         BikeType   @default(CITY)
  status       BikeStatus @default(AVAILABLE)
  /// Rental price per hour, in cents.
  pricePerHour Int
  imageUrl     String?
  description  String?
  stationId    String?
  station      Station?   @relation(fields: [stationId], references: [id], onDelete: SetNull)
  rentals      Rental[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([type])
}

model Rental {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bikeId String
  bike   Bike   @relation(fields: [bikeId], references: [id], onDelete: Restrict)

  status     RentalStatus @default(PENDING)
  startsAt   DateTime
  endsAt     DateTime
  returnedAt DateTime?
  /// Ids of the add-ons booked with the bike, see src/lib/accessories.ts.
  accessories String[]    @default([])
  /// Total rental price including add-ons, in cents.
  totalPrice Int

  verification VerificationCode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bikeId])
  @@index([status])
}

/// One-time code emailed to the renter to confirm a pending rental.
model VerificationCode {
  id       String @id @default(cuid())
  rentalId String @unique
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  /// SHA-256 hash of the code — the plain code is never stored.
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

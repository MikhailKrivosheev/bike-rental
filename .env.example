# Connect to Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://bike:bike@localhost:5433/bike_rental?schema=public"

# Serverless deployments only. DATABASE_URL there points at a transaction-mode
# pooler (PgBouncer), which cannot run migrations — set this to the provider's
# direct connection string so `prisma migrate deploy` bypasses the pooler.
# DIRECT_DATABASE_URL=""

# Connections per instance. The default of 5 suits Vercel; raise it only for a
# long-lived server that owns the whole connection budget.
# DATABASE_POOL_MAX="5"

# Accepts the test OTP 111111 in production builds too. Local testing only —
# never set this in a real deployment.
ALLOW_DEV_OTP="true"

# Signs session cookies. Any long random string works locally; use a real
# secret (e.g. `openssl rand -base64 32`) in production.
AUTH_SECRET="dev-secret-change-me"
